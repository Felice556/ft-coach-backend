generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Ruolo {
  TRAINER
  CLIENTE
}

model User {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  password String
  ruolo    Ruolo

  // Quando ha confermato l'email dal link ricevuto (null = non ancora). Non blocca l'accesso:
  // serve a scoprire gli errori di battitura e a chi riceve un'iscrizione non sua per annullarla.
  // Gli account creati prima di questa funzione risultano già confermati (vedi la migrazione).
  emailConfermataIl DateTime?

  // true dopo che il trainer ha reimpostato la password: al prossimo accesso
  // l'utente deve sceglierne una sua (così il trainer non conosce quella definitiva).
  passwordTemporanea Boolean @default(false)
  // Sale di 1 a ogni cambio/reset della password: i token (accessi) vecchi smettono
  // di funzionare, così un telefono perso o condiviso viene disconnesso.
  versioneToken      Int     @default(0)

  // Amministratore dell'app: l'unico che può creare gli inviti per i nuovi trainer.
  // NESSUNA rotta dell'app scrive questo campo: è stato impostato una volta sola dalla
  // migrazione "trainer_separati" sul primo trainer (Felice). Nessuno può diventarlo da sé.
  admin Boolean @default(false)

  // Solo per i TRAINER che si registrano da soli, SENZA invito: l'account resta bloccato
  // finché l'amministratore non lo approva (false = in attesa). Con un invito trainer, o per
  // i clienti, è subito true. Tutti gli account esistenti prima di questa modifica sono true.
  approvato     Boolean   @default(true)
  // Due righe con cui il trainer in attesa si presenta all'amministratore (palestra, città...).
  presentazione String?
  // Quando ha chiesto di entrare (solo per i trainer in attesa).
  richiestaIl   DateTime?
  // Quanti clienti dice di seguire, a fasce: "1-10", "11-30", "31-50", "50+" (solo trainer in attesa).
  fasciaClienti String?

  // Account sospeso: non può accedere, ma NESSUN dato viene cancellato e si può riattivare.
  // Un trainer lo decide l'amministratore; un cliente lo decide il suo trainer.
  // Se è sospeso un trainer, restano fuori anche i suoi clienti.
  sospeso   Boolean   @default(false)
  sospesoIl DateTime?

  // Solo per i CLIENTI: il trainer che li segue. Ogni trainer vede SOLO i suoi clienti.
  // Per i trainer resta vuoto. Un CLIENTE senza trainer "si allena da solo": crea le sue schede
  // (fino a 3 gratis) e può collegarsi a un trainer quando vuole, o lasciarlo.
  trainerId Int?
  // Da quando il cliente è collegato al trainer attuale (null = da sempre, es. registrato con il suo invito).
  // Il trainer vede misure, cardio, passi e diario SOLO da questa data in poi: lo storico di prima
  // (da solo o con un altro trainer) resta privato.
  collegatoIl DateTime?
  trainer   User?  @relation("ClientiDelTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  clienti   User[] @relation("ClientiDelTrainer")

  // Un cliente possiede delle schede; un trainer non usa questo campo.
  schede   Scheda[] @relation("SchedeDelCliente")
  // Schede preparate da questo trainer (per i suoi clienti, attuali o passati).
  schedeCreate Scheda[] @relation("SchedeDelTrainer")

  // Storico allenamenti: presente solo se ruolo = CLIENTE.
  registri RegistroAllenamento[]

  // Libreria di esercizi riutilizzabili: presente solo se ruolo = TRAINER.
  presetEsercizi EsercizioPreset[]

  // Libreria di note/tecniche riutilizzabili su qualsiasi esercizio: solo TRAINER.
  presetNote NotaPreset[]

  // Allenamenti chiusi con "Allenamento completato": presente solo se ruolo = CLIENTE.
  sessioni SessioneAllenamento[]

  // Inviti creati da questo trainer / inviti usati da questo cliente (per registrarsi o,
  // più avanti, per collegarsi a un trainer: un cliente può cambiare trainer, quindi più di uno).
  invitiCreati Invito[] @relation("InvitiCreati")
  invitiUsati  Invito[] @relation("InvitoUsato")

  // Peso corporeo e % di massa grassa del cliente / misure inserite da questo utente.
  misure         MisuraCorporea[] @relation("MisureDelCliente")
  misureInserite MisuraCorporea[] @relation("MisureInserite")

  // Cardio e passi (solo CLIENTI): il piano cardio deciso dal trainer, il cardio fatto e i passi.
  // obiettivoPassi = passi al giorno da raggiungere, lo decide il trainer (null = nessun obiettivo).
  obiettivoPassi  Int?
  obiettiviCardio ObiettivoCardio[]
  cardioFatto     CardioFatto[]
  passi           PassiGiornalieri[]

  // Diario alimentare (solo CLIENTI): serve un consenso apposito (dati che possono riguardare la salute).
  // null = consenso non dato (o ritirato: in quel caso il diario viene cancellato).
  consensoDiarioIl DateTime?
  diario           GiornoDiario[]

  // Programmi Liftio "in arrivo" per cui ha chiesto di essere avvisato.
  avvisiProgrammi AvvisoProgramma[]

  // Link "Password dimenticata?" mandati per email (vedi ResetPassword).
  resetPassword ResetPassword[]
  // Link "Conferma la tua email" / "Non sono stato io" (vedi ConfermaEmail).
  confermeEmail ConfermaEmail[]

  @@index([trainerId])
}

// "Password dimenticata?": un link mandato per email, valido 30 minuti e usabile UNA volta.
// Nel database c'è solo l'impronta (SHA-256) del codice del link, mai il codice: chi leggesse
// il database non potrebbe usarlo. Le righe servono anche a limitare i link chiesti in un'ora;
// si cancellano da sole dopo un giorno e spariscono con l'account.
model ResetPassword {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  scadeIl   DateTime
  usatoIl   DateTime?
  creatoIl  DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email di conferma dopo l'iscrizione (o dopo un cambio di email): un link con due azioni,
// "Conferma la mia email" e "Non sono stato io: annulla la registrazione". Vale 7 giorni.
// Come per ResetPassword, nel database c'è solo l'impronta del codice. `email` è l'indirizzo
// a cui è stato mandato: se poi l'email dell'account cambia, il vecchio link non vale più.
model ConfermaEmail {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  email     String
  scadeIl   DateTime
  usatoIl   DateTime?
  creatoIl  DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Avvisami" su un programma Liftio in arrivo: serve a sapere quali programmi interessano
// e ad avvisare la persona quando sarà pronto. Si toglie con un tocco; sparisce con l'account.
model AvvisoProgramma {
  id        Int      @id @default(autoincrement())
  programma String // chiave del programma: "principiante", "intermedio" o "avanzato" (l'elenco sta nel backend)
  creatoIl  DateTime @default(now())
  // Fino a quando ha già visto gli annunci dell'amministratore su questo programma (null = mai).
  annuncioVistoIl DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programma])
}

// Messaggio che l'amministratore manda a chi aspetta un programma (es. "Il programma Principiante è pronto!").
// Lo vede nell'app chi ha toccato "Avvisami" su quel programma.
model AnnuncioProgramma {
  id        Int      @id @default(autoincrement())
  programma String
  messaggio String
  creatoIl  DateTime @default(now())

  @@index([programma, creatoIl])
}

// Diario alimentare: una pagina per giorno, la scrive il cliente. Il trainer la legge e può
// lasciare un commento generale (NON è un piano alimentare: niente calorie né diete).
model GiornoDiario {
  id         Int      @id @default(autoincrement())
  data       DateTime @db.Date
  olioCucchiai Float? // cucchiai di olio usati nella giornata
  acquaLitri   Float? // acqua bevuta
  sensazioni   String? // come si è sentito (fame, energia...), facoltativo
  // Commento del trainer a questa giornata (uno per giorno, lo può correggere).
  commentoTrainer String?
  commentatoIl    DateTime?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  clienteId Int
  cliente   User @relation(fields: [clienteId], references: [id])

  pasti PastoDiario[]

  @@unique([clienteId, data])
}

enum TipoPasto {
  COLAZIONE
  SPUNTINO_MATTINA
  PRANZO
  SPUNTINO_POMERIGGIO
  CENA
  EXTRA // voce aggiunta dal cliente, con un nome suo (es. "Post cena", "Pre allenamento")
}

// Un pasto della giornata, scritto a parole dal cliente (es. "Pasta al pomodoro, insalata").
// I 5 pasti fissi compaiono al massimo una volta al giorno (lo controlla il server);
// le voci EXTRA possono essere più d'una, ognuna con il suo nome.
model PastoDiario {
  id     Int       @id @default(autoincrement())
  tipo   TipoPasto
  nome   String? // solo per EXTRA: il nome scelto dal cliente
  ordine Int       @default(0) // posizione tra le voci EXTRA (0, 1, 2…)
  testo  String
  ora    String? // "13:15", facoltativa

  giornoId Int
  giorno   GiornoDiario @relation(fields: [giornoId], references: [id], onDelete: Cascade)

  @@index([giornoId])
}

// Un'attività cardio del piano che il trainer assegna al cliente, fuori dalle schede di allenamento.
// Es. "Camminata in salita · 30 minuti · 3 volte a settimana · pendenza 8%".
model ObiettivoCardio {
  id             Int      @id @default(autoincrement())
  attivita       String // es. "Camminata veloce", "Bici", "Ellittica"
  minuti         Int // durata di ogni sessione
  volteSettimana Int // quante sessioni a settimana
  nota           String? // intensità, zona cardio, pendenza...
  creatoIl       DateTime @default(now())

  clienteId Int
  cliente   User @relation(fields: [clienteId], references: [id])

  sessioni CardioFatto[]

  @@index([clienteId])
}

// Una sessione di cardio fatta dal cliente (la scrive lui). Se togli l'attività dal piano,
// le sessioni fatte restano: perdono solo il collegamento, il nome dell'attività è salvato qui.
model CardioFatto {
  id         Int      @id @default(autoincrement())
  attivita   String
  minuti     Int
  distanzaKm Float? // facoltativa
  nota       String?
  data       DateTime @db.Date // solo il giorno
  creatoIl   DateTime @default(now())

  obiettivoId Int?
  obiettivo   ObiettivoCardio? @relation(fields: [obiettivoId], references: [id], onDelete: SetNull)

  clienteId Int
  cliente   User @relation(fields: [clienteId], references: [id])

  @@index([clienteId, data])
}

// Passi fatti dal cliente in un giorno: uno solo per giorno (reinserendo, si corregge).
model PassiGiornalieri {
  id           Int      @id @default(autoincrement())
  passi        Int
  data         DateTime @db.Date
  aggiornatoIl DateTime @updatedAt

  clienteId Int
  cliente   User @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, data])
}

enum TipoMisura {
  PESO // kg, lo inserisce il cliente
  MASSA_GRASSA // %, la inserisce il trainer
}

// Una misura del corpo in un giorno: al massimo una per tipo al giorno
// (se si reinserisce lo stesso giorno, il valore viene corretto, non duplicato).
model MisuraCorporea {
  id           Int        @id @default(autoincrement())
  tipo         TipoMisura
  valore       Float
  data         DateTime   @db.Date // solo il giorno, senza ora
  creataIl     DateTime   @default(now())
  aggiornataIl DateTime   @updatedAt

  clienteId Int
  cliente   User @relation("MisureDelCliente", fields: [clienteId], references: [id])

  // Chi l'ha scritta (il cliente stesso o il trainer).
  inseritaDaId Int
  inseritaDa   User @relation("MisureInserite", fields: [inseritaDaId], references: [id])

  @@unique([clienteId, tipo, data])
}

// Invito personale per registrarsi come cliente: il trainer lo crea e lo dà a una persona.
// Vale UNA volta sola e fino alla scadenza; non si cancella mai (resta lo storico di chi l'ha usato).
model Invito {
  id          Int       @id @default(autoincrement())
  codice      String    @unique // es. "K7M3-Q9TX"
  nota        String? // per chi è (es. "Marco Rossi"), la scrive il trainer
  // CLIENTE: invito che un trainer dà a un suo cliente.
  // TRAINER: invito per un nuovo trainer, lo può creare solo l'amministratore.
  ruolo       Ruolo     @default(CLIENTE)
  creatoIl    DateTime  @default(now())
  scadeIl     DateTime
  usatoIl     DateTime?
  annullatoIl DateTime?

  trainerId Int
  trainer   User @relation("InvitiCreati", fields: [trainerId], references: [id])

  // Chi ha usato questo invito (al massimo una persona; una persona può usarne più d'uno nel tempo).
  usatoDaId Int?
  usatoDa   User? @relation("InvitoUsato", fields: [usatoDaId], references: [id])

  @@index([usatoDaId])
}

// Nota/tecnica salvata dal trainer, NON legata a un esercizio: si aggiunge con un
// tocco alla nota di qualsiasi esercizio (es. "3 secondi di isometria in basso").
model NotaPreset {
  id    Int    @id @default(autoincrement())
  testo String

  trainerId Int
  trainer   User @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

// Un allenamento concluso dal cliente. I numeri (serie, volume) li calcola il
// backend dalle serie registrate, non li manda il telefono: così il trainer
// vede dati affidabili.
model SessioneAllenamento {
  id          Int      @id @default(autoincrement())
  completataIl DateTime @default(now())
  serieFatte  Int
  serieTotali Int
  volume      Float // somma di kg × reps della giornata

  // Feedback del cliente a fine allenamento (facoltativo, lo scrive lui).
  nota   String? // com'è andata: sensazioni, dolori, difficoltà...
  fatica Int? // voto da 1 (facilissimo) a 10 (al limite)

  // Restrict: una scheda con allenamenti conclusi NON può essere cancellata dal database.
  schedaId Int
  scheda   Scheda @relation(fields: [schedaId], references: [id], onDelete: Restrict)

  clienteId Int
  cliente   User @relation(fields: [clienteId], references: [id])
}

// Un esercizio "modello" salvato una volta dal trainer e riutilizzabile in
// più schede/clienti, senza doverlo riscrivere ogni volta. Le sole serie/reps/
// recupero restano decise scheda per scheda, perché cambiano da cliente a cliente.
// Gruppo muscolare di un esercizio della libreria: serve a dividerla in sezioni.
enum GruppoMuscolare {
  PETTO
  DORSO
  SPALLE
  BRACCIA
  GAMBE
  ADDOME
  CARDIO
  ALTRO
}

model EsercizioPreset {
  id          Int     @id @default(autoincrement())
  nome        String
  videoUrl    String?
  descrizione String?
  gruppo      GruppoMuscolare? // null = non ancora assegnato (esercizi salvati prima dei gruppi)

  trainerId Int
  trainer   User @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model Scheda {
  id        Int         @id @default(autoincrement())
  nome      String
  // Scheda archiviata: sparisce dalle viste ma resta nel database con tutto lo storico.
  // null = attiva. È il modo in cui "cancelliamo" senza perdere dati.
  archiviataIl DateTime?
  // Quando è stata creata: serve al trainer per capire quali schede sono le più vecchie.
  creataIl  DateTime  @default(now())
  clienteId Int
  cliente   User        @relation("SchedeDelCliente", fields: [clienteId], references: [id])
  // Chi l'ha preparata: il trainer (solo lui la vede e la modifica, e solo finché il cliente è suo).
  // Se il trainer elimina il suo account, la scheda resta al cliente con il suo storico (SetNull).
  trainerId Int?
  trainer   User?       @relation("SchedeDelTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  // true = scheda che il cliente si è creato da solo. Conta nel limite delle 3 gratis
  // e resta "in pausa" mentre il cliente è seguito da un trainer.
  personale Boolean     @default(false)
  esercizi  Esercizio[]
  sessioni  SessioneAllenamento[]

  @@index([clienteId])
  @@index([trainerId])
}

// Come un esercizio è collegato al SUCCESSIVO della scheda.
enum TipoCollegamento {
  SUPERSET // si passa subito al successivo, senza recupero in mezzo
  JUMPSET // si alterna col successivo, con il recupero tra uno e l'altro
}

model Esercizio {
  id              Int     @id @default(autoincrement())
  nome            String
  videoUrl        String?
  descrizione     String? // note libere del trainer: tecnica, tempo di isometria, avvertenze, ecc.
  serieTarget     Int
  repsTarget      Int? // null = "Max" (a cedimento); con repsMax è il minimo dell'intervallo
  repsMax         Int? // solo per gli intervalli: "6-9" → repsTarget 6, repsMax 9
  // "+ max" (drop set): fatte le ripetizioni previste, si scala il peso e si continua fino a cedimento.
  // Es. "6-9 + max". Non ha senso con "Max" da solo (repsTarget null): lì resta sempre false.
  piuMax          Boolean @default(false)
  // "+ rp" (rest-pause): arrivato a cedimento si ferma questi secondi e riprende con lo stesso peso.
  // Es. "6-9 + rp 15". null = niente rest-pause. Esclude "+ max" (o l'uno o l'altro).
  rpSecondi       Int?
  recuperoSecondi Int
  // Esercizio tolto da una scheda: resta nel database (con le serie registrate), solo nascosto.
  archiviatoIl    DateTime?
  // Collegato all'esercizio successivo (null = esercizio singolo). Più esercizi
  // collegati di fila formano un gruppo: superset, jumpset, triset...
  collegamento    TipoCollegamento?

  schedaId Int
  scheda   Scheda @relation(fields: [schedaId], references: [id], onDelete: Cascade)

  registri   RegistroAllenamento[]
  serieExtra SerieExtra[]
}

// Serie aggiunte dal trainer DOPO le serie normali di un esercizio, con numeri propri.
// Es. esercizio 2 × 10 (serieTarget = 2, repsTarget = 10) + una SerieExtra da
// 15 reps con nota "drop set": il cliente fa 3 serie, la terza con i suoi valori.
model SerieExtra {
  id              Int     @id @default(autoincrement())
  ordine          Int // posizione tra le serie extra (0, 1, 2…)
  reps            Int? // null = "Max" (a cedimento); con repsMax è il minimo dell'intervallo
  repsMax         Int? // solo per gli intervalli, come sopra
  piuMax          Boolean @default(false) // "+ max" (drop set), come sopra
  rpSecondi       Int? // "+ rp" (rest-pause) con la sua pausa in secondi, come sopra
  recuperoSecondi Int
  nota            String? // es. "drop set", "a cedimento", "fermo 2s al petto"

  esercizioId Int
  esercizio   Esercizio @relation(fields: [esercizioId], references: [id], onDelete: Cascade)
}

model RegistroAllenamento {
  id        Int      @id @default(autoincrement())
  pesoUsato Float
  repsFatte Int
  nota      String? // commento libero del cliente al trainer su questa sessione (dolore, sensazioni, difficoltà...)
  data      DateTime @default(now())

  // Restrict: il database rifiuta di cancellare un esercizio che ha serie registrate.
  // Seconda rete di sicurezza: anche un errore nel codice non può far sparire lo storico.
  esercizioId Int
  esercizio   Esercizio @relation(fields: [esercizioId], references: [id], onDelete: Restrict)

  clienteId Int
  cliente   User @relation(fields: [clienteId], references: [id])
}
